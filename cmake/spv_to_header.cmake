# cmake/spv_to_header.cmake
# Called by CMake at build time via:
#   cmake -DSPV=<path.spv> -DVAR=<variable_name> -DOUT=<output.h> -P spv_to_header.cmake
#
# Reads the binary SPIR-V file and emits a C++ header of the form:
#   static const uint32_t <VAR>[] = { 0x..., ... };
#   static const size_t   <VAR>_size = <byte_count>;

file(READ "${SPV}" raw HEX)
string(LENGTH "${raw}" hex_len)
math(EXPR byte_count "${hex_len} / 2")

# Build the uint32_t initialiser list by consuming 8 hex chars at a time (4 bytes).
set(words "")
math(EXPR word_count "${hex_len} / 8")
set(pos 0)
foreach(idx RANGE 1 ${word_count})
    math(EXPR pos "(${idx} - 1) * 8")
    string(SUBSTRING "${raw}" ${pos} 8 chunk)
    # SPIR-V files are little-endian; CMake file(READ HEX) is byte-sequential.
    # Reverse byte order to reconstruct little-endian uint32 as a hex literal.
    string(SUBSTRING "${chunk}" 0 2 b0)
    string(SUBSTRING "${chunk}" 2 2 b1)
    string(SUBSTRING "${chunk}" 4 2 b2)
    string(SUBSTRING "${chunk}" 6 2 b3)
    list(APPEND words "0x${b3}${b2}${b1}${b0}u")
endforeach()

list(JOIN words ", " word_str)

file(WRITE "${OUT}"
"// Auto-generated by cmake/spv_to_header.cmake — do not edit.
static const uint32_t ${VAR}[] = { ${word_str} };
static const size_t   ${VAR}_size = ${byte_count};
")
